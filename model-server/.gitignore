# -----------------------------------------------------------------------------
# Combined .gitignore for JavaScript (Node.js) and Python
# -----------------------------------------------------------------------------

# --------------------------
# 1. Dependency Directories
# --------------------------

# JavaScript / Node.js
# Local modules for Node.js projects
/node_modules

# Python
# Virtual environment directory (recommended)
/venv
# Standard environment names
/.env
/env

# --------------------------
# 2. Build and Output Artifacts
# --------------------------

# JavaScript / Node.js
# Production build directory (e.g., React, Vue, Webpack)
/build
/dist
/out
/public

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm
.eslintcache

# Python
# Bytecode files
*.pyc
__pycache__/
# Generated documentation/packaging files
.Python
build/
dist/
*.egg-info/
htmlcov/

# --------------------------
# 3. Development and Testing
# --------------------------

# Python
# Coverage testing artifacts
.coverage
.tox/

# JavaScript
# Jest/Mocha caches
/coverage
/.nyc_output
/.cache

# --------------------------
# 4. OS and Editor Files
# --------------------------

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Thumbnails
._*
*~

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Common Editors and IDEs
# Visual Studio Code
.vscode/
# JetBrains IDEs (PyCharm, WebStorm)
.idea/
# Vim
*.swp
*.bak